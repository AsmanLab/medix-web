VITE_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Push-уведомления в браузере (Firebase Cloud Messaging).
# Все пять значений публичные — они видны в собранном бандле и это нормально;
# право отправлять даёт service account на бэкенде, а не они.
#
# Пока переменные пустые, push на витрине просто выключен: блок «Уведомления
# в браузере» в профиле не показывается. Заполняются все пять или ни одной —
# частичный конфиг заставил бы браузер спросить разрешение и ничего не прислать.
#
# Где взять — medix-core/docs/PUSH_SETUP.md
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_VAPID_KEY=
